# credenciais para rodar no localhost

# em "production" os cookies passam a exigir HTTPS (secure) e o Swagger (/api) é desativado
NODE_ENV = "development"

POSTGRES_DATABASE_URL = "postgresql://postgres:root@localhost:5432/postgres-chat-app?schema=public"
MONGO_DATABASE_URL = "mongodb://localhost:27017/chat-app"
SECRET_KEY_JWT = "secretkey1312312313123123"
SECRET_KEY_REFRESH_JWT = "secretkey42343434324242424234343432424242"
REDIS_URL = "redis://localhost:6379"
FRONT_END_URL ="http://localhost:5173"
ADMIN_SECRET_KEY= "adminsecretkey1234567890"

# OAuth Client ID (tipo "Web application") do Google Cloud Console
GOOGLE_CLIENT_ID = "xxxxxxx.apps.googleusercontent.com"

# STORAGE (compatível com S3)
# local: RustFS do docker-compose (npm run storage:setup cria o bucket e o CORS)
# produção: Cloudflare R2 -> STORAGE_ENDPOINT = "https://<account_id>.r2.cloudflarestorage.com", STORAGE_REGION = "auto",
#   STORAGE_FORCE_PATH_STYLE = "false" e as chaves de um API token do R2 com permissão de leitura/escrita no bucket
STORAGE_ENDPOINT = "http://localhost:9000"
STORAGE_REGION = "us-east-1"
STORAGE_FORCE_PATH_STYLE = "true"
STORAGE_BUCKET = "chat-app"
STORAGE_ACCESS_KEY_ID = "chatapp"
STORAGE_SECRET_ACCESS_KEY = "chatapp-secret"
